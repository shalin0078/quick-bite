# QuickBite Environment Configuration
# Provide your Supabase project credentials below.
# When left unset or using placeholders, QuickBite operates in robust Local Engine mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend API for transactional email delivery
VITE_RESEND_API_KEY=re_your_api_key_here

# App URL
VITE_APP_URL=http://localhost:5173
